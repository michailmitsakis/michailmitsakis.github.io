{% comment %}
  Local override of al_folio_core 1.0.15 _includes/projects.liquid.
  Adds two optional front-matter fields to each project card:
  status (a pill above the title) and result (one key result under the description).
{% endcomment %}
<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        {% if project.status %}
          <span class="card-status">{{ project.status }}</span>
        {% endif %}
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.result %}
          <p class="card-result">{{ project.result }}</p>
        {% endif %}
      </div>
    </div>
  </a>
</div>
